# StackChan Relay Server Configuration
# Copy to .env and fill in your tokens.

# Token for ESP32 polling (/poll and /ack endpoints)
POLL_TOKEN=change-me-poll

# Token for Claude.ai MCP connection (/sse endpoint)
MCP_TOKEN=change-me-mcp

# Server port (Cloudflare Tunnel or reverse proxy points here)
PORT=8011
